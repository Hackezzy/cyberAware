---
const navItems = [{ href: "/roadmap/", label: "Roadmap" }];

const exploreItems = [
  { href: "/simulations/", label: "Simulations" },
  { href: "/tools/", label: "Tools" },
  { href: "/quizzes/", label: "Quizzes" },
];

const trailingNavItems = [
  { href: "/progress/", label: "My Progress" },
  { href: "/about/", label: "About" },
];

function normalizePath(path: string) {
  return path.endsWith("/") && path !== "/" ? path.slice(0, -1) : path;
}

const currentPath = normalizePath(Astro.url.pathname);

function isCurrentItem(href: string) {
  const normalizedHref = normalizePath(href);
  return currentPath === normalizedHref || (href !== "/" && currentPath.startsWith(normalizedHref));
}

const exploreIsCurrent = exploreItems.some((item) => isCurrentItem(item.href));

const LINK_CLASSES =
  "block rounded-md px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)";
---

<header class="border-b border-(--color-border) bg-(--color-surface)">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-bold tracking-tight text-(--color-text) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-accent)"
    >
      <span aria-hidden="true" class="text-(--color-accent)">&#128737;</span>
      CyberAware
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="rounded-md border border-(--color-border) p-2 text-(--color-text) lg:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open menu"
    >
      <svg
        id="nav-toggle-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path d="M3 5h14M3 10h14M3 15h14"></path>
      </svg>
    </button>

    <ul
      id="nav-menu"
      class="hidden w-full flex-col gap-1 lg:flex lg:w-auto lg:flex-row lg:items-center lg:gap-2"
    >
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrentItem(item.href) ? "page" : undefined}
              class:list={[
                LINK_CLASSES,
                isCurrentItem(item.href)
                  ? "bg-(--color-surface-raised) text-(--color-accent)"
                  : "text-(--color-text-muted) hover:text-(--color-text)",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }

      <li id="explore-wrapper" class="relative">
        <button
          type="button"
          id="explore-toggle"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="explore-menu"
          class:list={[
            LINK_CLASSES,
            "flex w-full items-center justify-between gap-1 lg:w-auto",
            exploreIsCurrent
              ? "bg-(--color-surface-raised) text-(--color-accent)"
              : "text-(--color-text-muted) hover:text-(--color-text)",
          ]}
        >
          Explore
          <span aria-hidden="true" class="text-xs">&#9662;</span>
        </button>
        <ul
          id="explore-menu"
          hidden
          class="mt-1 space-y-1 pl-3 lg:absolute lg:left-0 lg:top-full lg:z-10 lg:mt-0 lg:min-w-40 lg:space-y-0 lg:rounded-md lg:border lg:border-(--color-border) lg:bg-(--color-surface) lg:p-1.5 lg:pl-1.5 lg:pt-2 lg:shadow-lg"
        >
          {
            exploreItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrentItem(item.href) ? "page" : undefined}
                  class:list={[
                    LINK_CLASSES,
                    isCurrentItem(item.href)
                      ? "bg-(--color-surface-raised) text-(--color-accent)"
                      : "text-(--color-text-muted) hover:text-(--color-text)",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </li>

      {
        trailingNavItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrentItem(item.href) ? "page" : undefined}
              class:list={[
                LINK_CLASSES,
                isCurrentItem(item.href)
                  ? "bg-(--color-surface-raised) text-(--color-accent)"
                  : "text-(--color-text-muted) hover:text-(--color-text)",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <button
          type="button"
          id="theme-toggle"
          aria-pressed="false"
          class="block w-full rounded-md px-3 py-2 text-left text-sm font-medium text-(--color-text-muted) transition-colors hover:text-(--color-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) lg:w-auto"
        >
          <span aria-hidden="true">&#9728;&#65039;</span> Light
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("nav-menu");
  const toggleIconPath = document.querySelector("#nav-toggle-icon path") as SVGPathElement | null;

  const HAMBURGER_PATH = "M3 5h14M3 10h14M3 15h14";
  const CLOSE_PATH = "M5 5l10 10M15 5L5 15";

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
    toggleIconPath?.setAttribute("d", isOpen ? CLOSE_PATH : HAMBURGER_PATH);
  });

  const exploreWrapper = document.getElementById("explore-wrapper") as HTMLLIElement | null;
  const exploreToggle = document.getElementById("explore-toggle") as HTMLButtonElement | null;
  const exploreMenu = document.getElementById("explore-menu") as HTMLUListElement | null;

  // Tracks whether the menu is currently open only because the mouse is
  // hovering it, as opposed to a deliberate click/keyboard activation. A
  // real mouse click always fires a `mouseenter` immediately beforehand, so
  // without this a click on the toggle would see the menu already open
  // (from hover) and immediately close it again — the button would appear
  // to do nothing, or flash open then shut.
  let openedViaHover = false;
  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  function cancelPendingClose() {
    if (closeTimer !== null) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
  }

  function openExploreMenu(viaHover = false) {
    if (!exploreMenu || !exploreToggle) return;
    cancelPendingClose();
    exploreMenu.hidden = false;
    exploreToggle.setAttribute("aria-expanded", "true");
    openedViaHover = viaHover;
  }

  function closeExploreMenu() {
    if (!exploreMenu || !exploreToggle) return;
    cancelPendingClose();
    exploreMenu.hidden = true;
    exploreToggle.setAttribute("aria-expanded", "false");
    openedViaHover = false;
  }

  // Closing on mouseleave happens after a short delay, cancelled if the
  // mouse re-enters in time. Without this, briefly crossing outside the
  // wrapper's hit area while moving from the toggle button down into the
  // dropdown panel — even a 1px gap, or a diagonal mouse path — closes the
  // menu before a real click ever lands.
  function scheduleClose() {
    cancelPendingClose();
    closeTimer = setTimeout(closeExploreMenu, 250);
  }

  if (exploreWrapper && exploreToggle && exploreMenu) {
    exploreToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      if (exploreMenu.hidden) {
        openExploreMenu(false);
      } else if (openedViaHover) {
        // A click right after a hover-open means "yes, keep this open" —
        // treat it as confirming the open state, not closing it.
        cancelPendingClose();
        openedViaHover = false;
      } else {
        closeExploreMenu();
      }
    });

    exploreWrapper.addEventListener("mouseenter", () => openExploreMenu(true));
    exploreWrapper.addEventListener("mouseleave", scheduleClose);

    exploreWrapper.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeExploreMenu();
        exploreToggle.focus();
      }
    });

    exploreWrapper.addEventListener("focusout", (event) => {
      const nextFocus = event.relatedTarget as Node | null;
      if (!nextFocus || !exploreWrapper.contains(nextFocus)) {
        closeExploreMenu();
      }
    });

    document.addEventListener("click", (event) => {
      if (!exploreWrapper.contains(event.target as Node)) {
        closeExploreMenu();
      }
    });
  }

  const themeToggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;

  function resolvedTheme(): "light" | "dark" {
    const explicit = document.documentElement.getAttribute("data-theme");
    if (explicit === "light" || explicit === "dark") return explicit;
    return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  }

  function updateToggleButton(theme: "light" | "dark") {
    if (!themeToggle) return;
    themeToggle.setAttribute("aria-pressed", String(theme === "light"));
    themeToggle.innerHTML =
      theme === "light"
        ? '<span aria-hidden="true">&#127769;</span> Dark'
        : '<span aria-hidden="true">&#9728;&#65039;</span> Light';
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    try {
      localStorage.setItem("cyberaware:theme", theme);
    } catch {}
    updateToggleButton(theme);
  }

  themeToggle?.addEventListener("click", () => {
    applyTheme(resolvedTheme() === "light" ? "dark" : "light");
  });

  updateToggleButton(resolvedTheme());
</script>
