---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DOMAINS, CURRICULUM_ITEMS } from "../../data/curriculum.js";

const TYPE_LABEL = { simulation: "Simulations", quiz: "Quizzes", tool: "Tools" };
const availableItems = CURRICULUM_ITEMS.filter((item) => item.available);
const domainsWithItems = DOMAINS.filter((domain) =>
  availableItems.some((item) => item.domain === domain.id)
);
---

<BaseLayout
  title="My Progress"
  description="A review of everything you've completed on CyberAware so far — by domain, by type, and as a full activity log. Stored only in your own browser."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      My Progress
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      A record of what you've actually done on CyberAware, not just what
      you've read. This is stored only in this browser &mdash; nothing is
      sent anywhere, and clearing your browser data clears this too.
    </p>

    <div id="empty-state" hidden class="mt-8 rounded-lg border border-dashed border-(--color-border) p-8 text-center">
      <p class="text-(--color-text)">You haven't completed anything yet.</p>
      <p class="mt-2 text-sm text-(--color-text-muted)">
        Try a simulation, a tool, or a quiz &mdash; each one you finish will
        show up here.
      </p>
      <a
        href="/roadmap/"
        class="mt-4 inline-block rounded-lg bg-(--color-accent) px-5 py-2.5 text-sm font-semibold text-(--color-bg) transition-colors hover:bg-(--color-accent-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
      >
        Start with the Roadmap
      </a>
    </div>

    <div id="progress-content">
      <div class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-4">
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-(--color-text)">Overall progress</span>
          <span id="overall-progress-text" class="text-(--color-text-muted)">0 / 0 complete</span>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-(--color-surface-raised)">
          <div
            id="overall-progress-bar"
            class="h-full rounded-full bg-(--color-accent) transition-[width]"
            style="width: 0%"
          >
          </div>
        </div>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          ["simulation", "tool", "quiz"].map((type) => (
            <div
              data-type-card={type}
              class="rounded-lg border border-(--color-border) bg-(--color-surface) p-4 text-center"
            >
              <p data-type-count class="text-2xl font-extrabold text-(--color-text)">
                0 / 0
              </p>
              <p class="mt-1 text-sm text-(--color-text-muted)">{TYPE_LABEL[type]}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10">
        <h2 class="text-lg font-bold text-(--color-text)">By domain</h2>
        <div class="mt-4 space-y-4">
          {
            domainsWithItems.map((domain) => {
              const domainItems = availableItems.filter((item) => item.domain === domain.id);
              return (
                <div data-domain-card={domain.id}>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-(--color-text)">{domain.name}</span>
                    <span data-domain-count class="text-(--color-text-muted)">
                      0 / {domainItems.length}
                    </span>
                  </div>
                  <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-(--color-surface-raised)">
                    <div
                      data-domain-bar
                      class="h-full rounded-full bg-(--color-accent) transition-[width]"
                      style="width: 0%"
                    />
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>

      <div class="mt-10">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-lg font-bold text-(--color-text)">Activity log</h2>
          <button
            type="button"
            id="reset-progress"
            class="rounded-md border border-(--color-border) px-3 py-1.5 text-xs font-medium text-(--color-text-muted) transition-colors hover:border-(--color-danger) hover:text-(--color-danger) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
          >
            Reset progress
          </button>
        </div>
        <ul id="activity-log" class="mt-4 space-y-2"></ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { DOMAINS, CURRICULUM_ITEMS } from "../../data/curriculum.js";
  import { getCompletedIds, getCompletionMeta, getProgressSummary, resetProgress } from "../../lib/progress-store.js";

  const TYPE_LABEL: Record<string, string> = { simulation: "Simulation", quiz: "Quiz", tool: "Tool" };
  const DOMAIN_NAME: Record<string, string> = Object.fromEntries(DOMAINS.map((d) => [d.id, d.name]));

  const availableItems = CURRICULUM_ITEMS.filter((item) => item.available);
  const itemsById = new Map(availableItems.map((item) => [item.id, item]));

  const emptyState = document.getElementById("empty-state") as HTMLDivElement;
  const progressContent = document.getElementById("progress-content") as HTMLDivElement;
  const overallText = document.getElementById("overall-progress-text") as HTMLSpanElement;
  const overallBar = document.getElementById("overall-progress-bar") as HTMLDivElement;
  const activityLog = document.getElementById("activity-log") as HTMLUListElement;
  const resetBtn = document.getElementById("reset-progress") as HTMLButtonElement;

  function formatDate(iso: string) {
    try {
      return new Date(iso).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
    } catch {
      return iso;
    }
  }

  function render() {
    const completedIds = getCompletedIds().filter((id) => itemsById.has(id));

    if (completedIds.length === 0) {
      emptyState.hidden = false;
      progressContent.hidden = true;
      return;
    }
    emptyState.hidden = true;
    progressContent.hidden = false;

    const summary = getProgressSummary(availableItems);
    overallText.textContent = `${summary.completed} / ${summary.total} complete`;
    overallBar.style.width = `${summary.percent}%`;

    (["simulation", "tool", "quiz"] as const).forEach((type) => {
      const card = document.querySelector(`[data-type-card="${type}"]`);
      if (!card) return;
      const typeItems = availableItems.filter((item) => item.type === type);
      const typeSummary = getProgressSummary(typeItems);
      const countEl = card.querySelector("[data-type-count]") as HTMLParagraphElement;
      countEl.textContent = `${typeSummary.completed} / ${typeSummary.total}`;
    });

    document.querySelectorAll("[data-domain-card]").forEach((card) => {
      const domainId = card.getAttribute("data-domain-card") as string;
      const domainItems = availableItems.filter((item) => item.domain === domainId);
      const domainSummary = getProgressSummary(domainItems);
      const countEl = card.querySelector("[data-domain-count]") as HTMLSpanElement;
      const barEl = card.querySelector("[data-domain-bar]") as HTMLDivElement;
      countEl.textContent = `${domainSummary.completed} / ${domainSummary.total}`;
      barEl.style.width = `${domainSummary.percent}%`;
      barEl.classList.toggle("bg-(--color-safe)", domainSummary.percent === 100);
      barEl.classList.toggle("bg-(--color-accent)", domainSummary.percent < 100);
    });

    const entries = completedIds
      .map((id) => ({ item: itemsById.get(id)!, meta: getCompletionMeta(id) }))
      .filter((entry) => entry.meta)
      .sort((a, b) => new Date(b.meta.completedAt).getTime() - new Date(a.meta.completedAt).getTime());

    activityLog.innerHTML = entries
      .map(({ item, meta }) => {
        const scoreText =
          typeof meta.score === "number" && typeof meta.total === "number"
            ? `<span class="text-(--color-text-muted)">&middot; Score: ${meta.score}/${meta.total}</span>`
            : "";
        return `
        <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-(--color-border) bg-(--color-surface) px-4 py-3">
          <div class="flex flex-wrap items-center gap-2">
            <a href="${item.href}" class="text-sm font-medium text-(--color-text) hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)">${item.title}</a>
            <span class="rounded-full border border-(--color-border) px-2 py-0.5 text-xs text-(--color-text-muted)">${TYPE_LABEL[item.type]}</span>
            <span class="text-xs text-(--color-text-muted)">${DOMAIN_NAME[item.domain] ?? ""}</span>
          </div>
          <div class="flex items-center gap-2 text-xs">
            ${scoreText}
            <span class="text-(--color-text-muted)">${formatDate(meta.completedAt)}</span>
          </div>
        </li>`;
      })
      .join("");
  }

  resetBtn.addEventListener("click", () => {
    const confirmed = window.confirm(
      "Reset all progress on this device? This clears every completed simulation, tool, and quiz recorded in this browser. This can't be undone."
    );
    if (!confirmed) return;
    resetProgress();
    render();
  });

  render();
</script>
