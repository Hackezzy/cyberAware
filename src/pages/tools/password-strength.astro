---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Password Strength Analyzer"
  description="Type a password to see its strength and exactly which weaknesses would make it easier to guess — analyzed entirely in your browser."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      Password Strength Analyzer
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      Everything here is analyzed locally as you type &mdash; nothing is sent
      anywhere or stored. Even so, don't type a password you actually use
      elsewhere; try something similar in structure instead.
    </p>

    <div class="mt-8">
      <label for="password-input" class="block text-sm font-medium text-(--color-text)">
        Password
      </label>
      <div class="mt-1 flex gap-2">
        <input
          type="password"
          id="password-input"
          name="password"
          autocomplete="new-password"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-describedby="strength-details"
          class="w-full rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-2 font-mono text-(--color-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
          placeholder="Type a password to analyze"
        />
        <button
          type="button"
          id="toggle-visibility"
          aria-pressed="false"
          class="shrink-0 rounded-md border border-(--color-border) px-4 py-2 text-sm font-medium text-(--color-text) transition-colors hover:bg-(--color-surface-raised) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
        >
          Show
        </button>
      </div>

      <p id="strength-live" class="sr-only" aria-live="polite"></p>

      <div class="mt-4">
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-(--color-text)" id="strength-label">Strength: &mdash;</span>
          <span class="text-(--color-text-muted)" id="strength-score">0 / 100</span>
        </div>
        <div
          role="progressbar"
          id="strength-bar-track"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-labelledby="strength-label"
          class="mt-2 h-2 w-full overflow-hidden rounded-full bg-(--color-surface-raised)"
        >
          <div
            id="strength-bar-fill"
            class="h-full rounded-full bg-(--color-danger) transition-[width,background-color]"
            style="width: 0%"
          >
          </div>
        </div>
      </div>

      <div id="strength-details" class="mt-6 space-y-6">
        <div>
          <h2 class="text-sm font-semibold text-(--color-text-muted)">
            Character types used
          </h2>
          <ul id="character-classes" class="mt-2 flex flex-wrap gap-2 text-sm"></ul>
        </div>

        <div>
          <h2 class="text-sm font-semibold text-(--color-text-muted)">
            Estimated time to crack
          </h2>
          <p id="crack-time" class="mt-1 text-(--color-text)">
            Type a password above to see an estimate.
          </p>
        </div>

        <div>
          <h2 class="text-sm font-semibold text-(--color-text-muted)">Weaknesses found</h2>
          <ul id="flags-list" class="mt-2 space-y-3"></ul>
        </div>
      </div>
    </div>

    <div class="mt-12 rounded-lg border border-(--color-border) bg-(--color-surface) p-6">
      <h2 class="font-semibold text-(--color-text)">What actually makes a password strong?</h2>
      <p class="mt-2 text-sm text-(--color-text-muted)">
        Length matters more than complexity tricks. A long, random phrase like
        <code class="text-(--color-accent)">correct horse battery staple</code> is
        far harder to guess than a short password with substituted symbols like
        <code class="text-(--color-accent)">P@ssw0rd1!</code>, because attackers
        already check for common words and predictable substitutions before
        trying anything else.
      </p>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-extrabold tracking-tight text-(--color-text)">
        Credential Reuse Check
      </h2>
      <p class="mt-2 max-w-2xl text-(--color-text-muted)">
        The single most common way one data breach turns into many hacked
        accounts isn't a clever exploit &mdash; it's password reuse. Add a
        few of your accounts below (use fake labels and similar-but-not-real
        passwords, same as above) to see what an attacker's automated tools
        see when they find reused or lightly-tweaked passwords.
      </p>

      <p id="reuse-live" class="sr-only" aria-live="polite"></p>

      <div id="account-rows" class="mt-4 space-y-3"></div>

      <div class="mt-3 flex flex-wrap gap-2">
        <button
          type="button"
          id="add-account"
          class="rounded-md border border-(--color-border) px-4 py-2 text-sm font-medium text-(--color-text) transition-colors hover:bg-(--color-surface-raised) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) disabled:cursor-not-allowed disabled:opacity-40"
        >
          + Add account
        </button>
        <button
          type="button"
          id="toggle-all-passwords"
          aria-pressed="false"
          class="rounded-md border border-(--color-border) px-4 py-2 text-sm font-medium text-(--color-text) transition-colors hover:bg-(--color-surface-raised) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
        >
          Show passwords
        </button>
      </div>

      <div id="reuse-results" class="mt-6 space-y-3"></div>
    </div>

    <template id="account-row-template">
      <div
        data-row
        class="account-row flex flex-wrap items-start gap-2 rounded-lg border border-(--color-border) bg-(--color-surface) p-3"
      >
        <div class="min-w-[8rem] flex-1">
          <label class="block text-xs font-medium text-(--color-text-muted)">Account label</label>
          <input
            type="text"
            data-field="label"
            class="mt-1 w-full rounded-md border border-(--color-border) bg-(--color-bg) px-2 py-1.5 text-sm text-(--color-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
            placeholder="e.g. Email"
          />
        </div>
        <div class="min-w-[10rem] flex-1">
          <label class="block text-xs font-medium text-(--color-text-muted)">Password</label>
          <input
            type="password"
            data-field="password"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            class="mt-1 w-full rounded-md border border-(--color-border) bg-(--color-bg) px-2 py-1.5 font-mono text-sm text-(--color-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
            placeholder="Practice password"
          />
        </div>
        <button
          type="button"
          data-remove-row
          aria-label="Remove this account"
          class="mt-5 shrink-0 rounded-md border border-(--color-border) px-2 py-1.5 text-sm text-(--color-text-muted) transition-colors hover:border-(--color-danger) hover:text-(--color-danger) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) disabled:cursor-not-allowed disabled:opacity-40"
        >
          Remove
        </button>
      </div>
    </template>
  </section>
</BaseLayout>

<script>
  import { analyzePassword } from "../../lib/password-analyzer.js";
  import { analyzeCredentialReuse } from "../../lib/credential-reuse-analyzer.js";
  import { markCompleted, isCompleted } from "../../lib/progress-store.js";

  const input = document.getElementById("password-input") as HTMLInputElement;
  const toggleBtn = document.getElementById("toggle-visibility") as HTMLButtonElement;
  const strengthLive = document.getElementById("strength-live") as HTMLParagraphElement;
  const strengthLabel = document.getElementById("strength-label") as HTMLSpanElement;
  const strengthScore = document.getElementById("strength-score") as HTMLSpanElement;
  const barTrack = document.getElementById("strength-bar-track") as HTMLDivElement;
  const barFill = document.getElementById("strength-bar-fill") as HTMLDivElement;
  const characterClassesEl = document.getElementById("character-classes") as HTMLUListElement;
  const crackTimeEl = document.getElementById("crack-time") as HTMLParagraphElement;
  const flagsListEl = document.getElementById("flags-list") as HTMLUListElement;

  const LEVEL_COLOR: Record<string, string> = {
    "very-weak": "bg-(--color-danger)",
    weak: "bg-(--color-danger)",
    fair: "bg-(--color-warning)",
    strong: "bg-(--color-safe)",
    "very-strong": "bg-(--color-safe)",
  };

  const SEVERITY_CLASSES: Record<string, string> = {
    high: "border-(--color-danger) text-(--color-danger)",
    medium: "border-(--color-warning) text-(--color-warning)",
    low: "border-(--color-text-muted) text-(--color-text-muted)",
  };

  const CLASS_LABELS: Record<string, string> = {
    lower: "lowercase",
    upper: "UPPERCASE",
    digit: "0-9",
    symbol: "symbol",
  };

  function escapeHtml(value: string) {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  let lastAnnouncedLabel = "";

  toggleBtn.addEventListener("click", () => {
    const isHidden = input.type === "password";
    input.type = isHidden ? "text" : "password";
    toggleBtn.textContent = isHidden ? "Hide" : "Show";
    toggleBtn.setAttribute("aria-pressed", String(isHidden));
    input.focus();
  });

  input.addEventListener("input", () => {
    const result = analyzePassword(input.value);

    if (input.value && !isCompleted("tool-password-strength")) {
      markCompleted("tool-password-strength");
    }

    strengthLabel.textContent = `Strength: ${input.value ? result.label : "—"}`;
    strengthScore.textContent = `${result.score} / 100`;
    barTrack.setAttribute("aria-valuenow", String(result.score));
    barTrack.setAttribute("aria-valuetext", result.label);
    barFill.style.width = `${result.score}%`;
    barFill.className = `h-full rounded-full transition-[width,background-color] ${LEVEL_COLOR[result.level]}`;

    if (input.value && result.label !== lastAnnouncedLabel) {
      strengthLive.textContent = `Password strength: ${result.label}`;
      lastAnnouncedLabel = result.label;
    } else if (!input.value) {
      strengthLive.textContent = "";
      lastAnnouncedLabel = "";
    }

    characterClassesEl.innerHTML = Object.entries(result.characterClasses)
      .map(([key, present]) => {
        const style = present
          ? "border-(--color-safe) text-(--color-safe)"
          : "border-(--color-border) text-(--color-text-muted)";
        const mark = present ? "✓" : "—";
        return `<li class="rounded-full border px-3 py-1 ${style}">${mark} ${CLASS_LABELS[key]}</li>`;
      })
      .join("");

    crackTimeEl.textContent = input.value
      ? `About ${result.crackTime} for an offline attacker to guess, at a rough estimate.`
      : "Type a password above to see an estimate.";

    flagsListEl.innerHTML = result.flags.length
      ? result.flags
          .map(
            (flag) => `
        <li class="rounded-lg border border-(--color-border) bg-(--color-surface-raised) p-4">
          <div class="flex items-center gap-2">
            <span class="rounded-full border px-2 py-0.5 text-xs font-semibold ${SEVERITY_CLASSES[flag.severity]}">
              ${flag.severity === "high" ? "High" : flag.severity === "medium" ? "Medium" : "Low"}
            </span>
            <h3 class="font-semibold text-(--color-text)">${escapeHtml(flag.title)}</h3>
          </div>
          <p class="mt-2 text-sm text-(--color-text-muted)">${escapeHtml(flag.description)}</p>
        </li>`
          )
          .join("")
      : input.value
        ? `<li class="rounded-lg border border-(--color-border) bg-(--color-surface-raised) p-4 text-sm text-(--color-text-muted)">No common weaknesses detected by this tool. That doesn't guarantee it's uncrackable &mdash; length and true randomness still matter most.</li>`
        : "";
  });

  // --- Credential Reuse Check ---
  const accountRowsEl = document.getElementById("account-rows") as HTMLDivElement;
  const addAccountBtn = document.getElementById("add-account") as HTMLButtonElement;
  const toggleAllBtn = document.getElementById("toggle-all-passwords") as HTMLButtonElement;
  const reuseResultsEl = document.getElementById("reuse-results") as HTMLDivElement;
  const reuseLive = document.getElementById("reuse-live") as HTMLParagraphElement;
  const rowTemplate = document.getElementById("account-row-template") as HTMLTemplateElement;

  const MAX_ROWS = 6;
  let rowCounter = 0;
  let passwordsVisible = false;

  function updateRemoveButtons() {
    const rows = accountRowsEl.querySelectorAll<HTMLDivElement>("[data-row]");
    addAccountBtn.disabled = rows.length >= MAX_ROWS;
    rows.forEach((row) => {
      const removeBtn = row.querySelector("[data-remove-row]") as HTMLButtonElement;
      removeBtn.disabled = rows.length <= 1;
    });
  }

  function addRow(label = "") {
    rowCounter += 1;
    const fragment = rowTemplate.content.cloneNode(true) as DocumentFragment;
    const row = fragment.querySelector("[data-row]") as HTMLDivElement;
    row.dataset.rowId = String(rowCounter);

    const labelInput = row.querySelector('[data-field="label"]') as HTMLInputElement;
    const passwordInput = row.querySelector('[data-field="password"]') as HTMLInputElement;
    const removeBtn = row.querySelector("[data-remove-row]") as HTMLButtonElement;

    labelInput.value = label;
    labelInput.id = `account-label-${rowCounter}`;
    passwordInput.id = `account-password-${rowCounter}`;
    passwordInput.type = passwordsVisible ? "text" : "password";

    labelInput.addEventListener("input", runReuseCheck);
    passwordInput.addEventListener("input", runReuseCheck);
    removeBtn.addEventListener("click", () => {
      row.remove();
      updateRemoveButtons();
      runReuseCheck();
      addAccountBtn.focus();
    });

    accountRowsEl.appendChild(row);
    updateRemoveButtons();
  }

  addAccountBtn.addEventListener("click", () => addRow());

  toggleAllBtn.addEventListener("click", () => {
    passwordsVisible = !passwordsVisible;
    toggleAllBtn.textContent = passwordsVisible ? "Hide passwords" : "Show passwords";
    toggleAllBtn.setAttribute("aria-pressed", String(passwordsVisible));
    accountRowsEl.querySelectorAll<HTMLInputElement>('[data-field="password"]').forEach((el) => {
      el.type = passwordsVisible ? "text" : "password";
    });
  });

  function getAccounts() {
    return Array.from(accountRowsEl.querySelectorAll<HTMLDivElement>("[data-row]")).map((row) => ({
      id: row.dataset.rowId as string,
      label: (row.querySelector('[data-field="label"]') as HTMLInputElement).value.trim(),
      password: (row.querySelector('[data-field="password"]') as HTMLInputElement).value,
    }));
  }

  let lastReuseAnnouncement = "";

  function runReuseCheck() {
    const accounts = getAccounts();
    const result = analyzeCredentialReuse(accounts);

    if (result.accountsWithPasswords > 0 && !isCompleted("tool-password-strength")) {
      markCompleted("tool-password-strength");
    }

    const labelFor = (account: { id: string; label: string }) => account.label || `Account ${account.id}`;

    const groupsHtml: string[] = [];

    result.exactReuseGroups.forEach((group) => {
      const names = group.map(labelFor).map(escapeHtml).join(", ");
      groupsHtml.push(`
        <div class="rounded-lg border-2 border-(--color-danger) bg-(--color-danger)/10 p-4">
          <p class="font-semibold text-(--color-danger)">Exact same password reused: ${names}</p>
          <p class="mt-1 text-sm text-(--color-text-muted)">
            If any one of these gets breached, an attacker's automated tools
            try that exact password against your other accounts within
            minutes. This is called credential stuffing, and it's how a
            single leaked site turns into many hacked accounts.
          </p>
        </div>`);
    });

    result.similarReuseGroups.forEach((group) => {
      const names = group.map(labelFor).map(escapeHtml).join(", ");
      groupsHtml.push(`
        <div class="rounded-lg border-2 border-(--color-warning) bg-(--color-warning)/10 p-4">
          <p class="font-semibold text-(--color-warning)">Lightly-tweaked variations reused: ${names}</p>
          <p class="mt-1 text-sm text-(--color-text-muted)">
            These passwords only differ by a number, symbol, or year at the
            end. Credential-stuffing tools automatically try exactly these
            kinds of small tweaks, so this offers much less protection than
            it feels like.
          </p>
        </div>`);
    });

    let statusHtml = "";
    if (result.accountsWithPasswords === 0) {
      statusHtml = `<p class="text-sm text-(--color-text-muted)">Add at least two accounts above to check for reuse.</p>`;
    } else if (result.accountsWithPasswords === 1) {
      statusHtml = `<p class="text-sm text-(--color-text-muted)">Add one more account to compare passwords.</p>`;
    } else if (!result.hasReuse) {
      statusHtml = `<div class="rounded-lg border-2 border-(--color-safe) bg-(--color-safe)/10 p-4">
        <p class="font-semibold text-(--color-safe)">&#10003; No reuse detected between what you've entered.</p>
        <p class="mt-1 text-sm text-(--color-text-muted)">
          This offline tool can only compare the passwords you typed against
          each other &mdash; it can't check real data-breach databases,
          since this site never sends anything over the network. A password
          manager that generates a unique password per site is still the
          most reliable way to guarantee this.
        </p>
      </div>`;
    }

    reuseResultsEl.innerHTML = groupsHtml.join("") + statusHtml;

    const groupCount = result.exactReuseGroups.length + result.similarReuseGroups.length;
    const announcement = result.hasReuse
      ? `Reuse detected across ${groupCount} group${groupCount === 1 ? "" : "s"} of accounts.`
      : result.accountsWithPasswords > 1
        ? "No reuse detected."
        : "";
    if (announcement && announcement !== lastReuseAnnouncement) {
      reuseLive.textContent = announcement;
      lastReuseAnnouncement = announcement;
    }
  }

  // Seed with two starter rows so the feature is immediately obvious
  // without requiring the user to already know what to type.
  addRow("Email");
  addRow("Shopping");
  runReuseCheck();
</script>
