---
import BaseLayout from "../../layouts/BaseLayout.astro";
import sampleUrls from "../../data/sample-urls.json";
---

<BaseLayout
  title="URL Safety Checker"
  description="Paste a URL to see a breakdown of its structure and any suspicious patterns — analyzed entirely in your browser."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      URL Safety Checker
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      Paste a URL below or load a sample to see a structural breakdown and any
      suspicious patterns. Everything is analyzed locally &mdash; this tool
      never visits or fetches the URL, it only inspects the text.
    </p>

    <div class="mt-8">
      <h2 class="text-sm font-semibold text-(--color-text-muted)">
        Load a sample URL
      </h2>
      <div id="sample-buttons" class="mt-3 flex flex-wrap gap-2">
        {
          sampleUrls.map((sample) => (
            <button
              type="button"
              data-sample-id={sample.id}
              class="rounded-full border border-(--color-border) px-4 py-2 text-sm text-(--color-text) transition-colors hover:border-(--color-accent) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
            >
              {sample.label}
            </button>
          ))
        }
      </div>
    </div>

    <form id="check-form" class="mt-8 flex flex-col gap-2 sm:flex-row sm:items-end">
      <div class="flex-1">
        <label for="url-input" class="block text-sm font-medium text-(--color-text)">
          URL to check
        </label>
        <input
          type="text"
          id="url-input"
          name="url"
          placeholder="https://example.com"
          class="mt-1 w-full rounded-md border border-(--color-border) bg-(--color-surface) px-3 py-2 font-mono text-sm text-(--color-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
        />
      </div>
      <button
        type="submit"
        class="rounded-lg bg-(--color-accent) px-6 py-3 font-semibold text-(--color-bg) transition-colors hover:bg-(--color-accent-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
      >
        Check URL
      </button>
    </form>

    <p id="parse-error" class="mt-4 hidden text-sm text-(--color-danger)" role="alert"></p>

    <div id="results" aria-live="polite" class="mt-10 hidden">
      <div id="risk-banner" class="rounded-lg border-2 p-6">
        <p class="text-sm font-semibold uppercase tracking-wide">Risk assessment</p>
        <p id="risk-label" class="mt-1 text-2xl font-bold"></p>
        <p id="risk-score" class="mt-1 text-sm opacity-80"></p>
      </div>

      <div class="mt-6">
        <h3 class="text-sm font-semibold text-(--color-text-muted)">URL breakdown</h3>
        <ul id="breakdown-list" class="mt-2 space-y-1"></ul>
      </div>

      <div class="mt-6">
        <h3 class="text-sm font-semibold text-(--color-text-muted)">Flags found</h3>
        <ul id="flags-list" class="mt-2 space-y-3"></ul>
      </div>
    </div>

    <div class="mt-12 rounded-lg border border-(--color-border) bg-(--color-surface) p-6">
      <h2 class="font-semibold text-(--color-text)">What makes a URL suspicious?</h2>
      <p class="mt-2 text-sm text-(--color-text-muted)">
        The only part of a URL that matters for "where does this actually go" is the domain right before the first single slash &mdash; not anything that comes after it, and not brand names that appear earlier as a subdomain. Attackers exploit that gap: a link like <code class="text-(--color-accent)">paypal.com.secure-verify.ru</code> contains the word "paypal" but the real domain is <code class="text-(--color-accent)">secure-verify.ru</code>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { analyzeUrl } from "../../lib/url-checker.js";
  import sampleUrls from "../../data/sample-urls.json";
  import { markCompleted } from "../../lib/progress-store.js";

  const form = document.getElementById("check-form") as HTMLFormElement;
  const urlInput = document.getElementById("url-input") as HTMLInputElement;
  const sampleButtonsEl = document.getElementById("sample-buttons") as HTMLDivElement;
  const resultsEl = document.getElementById("results") as HTMLDivElement;
  const parseErrorEl = document.getElementById("parse-error") as HTMLParagraphElement;
  const riskBanner = document.getElementById("risk-banner") as HTMLDivElement;
  const riskLabelEl = document.getElementById("risk-label") as HTMLParagraphElement;
  const riskScoreEl = document.getElementById("risk-score") as HTMLParagraphElement;
  const breakdownListEl = document.getElementById("breakdown-list") as HTMLUListElement;
  const flagsListEl = document.getElementById("flags-list") as HTMLUListElement;

  const RISK_BANNER_CLASSES: Record<string, string> = {
    high: "border-(--color-danger) bg-(--color-danger)/10 text-(--color-danger)",
    medium: "border-(--color-warning) bg-(--color-warning)/10 text-(--color-warning)",
    low: "border-(--color-safe) bg-(--color-safe)/10 text-(--color-safe)",
  };

  const SEVERITY_CLASSES: Record<string, string> = {
    high: "border-(--color-danger) text-(--color-danger)",
    medium: "border-(--color-warning) text-(--color-warning)",
    low: "border-(--color-text-muted) text-(--color-text-muted)",
  };

  const SEVERITY_LABEL: Record<string, string> = { high: "High", medium: "Medium", low: "Low" };

  function escapeHtml(value: string) {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  sampleButtonsEl.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "button[data-sample-id]"
    );
    if (!target) return;
    const sample = sampleUrls.find((s) => s.id === target.dataset.sampleId);
    if (!sample) return;
    urlInput.value = sample.url;
    runCheck(sample.url);
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    runCheck(urlInput.value);
  });

  function runCheck(rawUrl: string) {
    const result = analyzeUrl(rawUrl);

    if (!result.valid) {
      resultsEl.classList.add("hidden");
      parseErrorEl.textContent = rawUrl.trim()
        ? "That doesn't look like a valid URL. Try including \"https://\" at the start."
        : "Enter a URL above to check it.";
      parseErrorEl.classList.remove("hidden");
      return;
    }

    parseErrorEl.classList.add("hidden");
    renderResults(result);
  }

  function renderResults(result: ReturnType<typeof analyzeUrl>) {
    markCompleted("tool-url-checker");

    riskBanner.className = `rounded-lg border-2 p-6 ${RISK_BANNER_CLASSES[result.riskLevel]}`;
    riskLabelEl.textContent = result.riskLabel;
    riskScoreEl.textContent = `Score: ${result.score}/100 · ${result.flags.length} flag${result.flags.length === 1 ? "" : "s"} found`;

    const b = result.breakdown!;
    const rows: [string, string][] = [
      ["Protocol", b.protocol],
      ["Domain", b.hostname || "(none)"],
      ["Port", b.port],
      ["Path", b.path],
      [
        "Query parameters",
        b.queryParams.length
          ? b.queryParams.map((p) => `${p.key}=${p.value}`).join(", ")
          : "(none)",
      ],
    ];
    breakdownListEl.innerHTML = rows
      .map(
        ([label, value]) => `
      <li class="rounded border border-(--color-border) bg-(--color-bg) px-3 py-2 font-mono text-xs text-(--color-text-muted)">
        ${escapeHtml(label)}: <span class="text-(--color-text)">${escapeHtml(value)}</span>
      </li>`
      )
      .join("");

    flagsListEl.innerHTML = result.flags.length
      ? result.flags
          .map(
            (flag) => `
        <li class="rounded-lg border border-(--color-border) bg-(--color-surface-raised) p-4">
          <div class="flex items-center gap-2">
            <span class="rounded-full border px-2 py-0.5 text-xs font-semibold ${SEVERITY_CLASSES[flag.severity]}">
              ${SEVERITY_LABEL[flag.severity]}
            </span>
            <h4 class="font-semibold text-(--color-text)">${escapeHtml(flag.title)}</h4>
          </div>
          <p class="mt-2 text-sm text-(--color-text-muted)">${escapeHtml(flag.description)}</p>
          ${
            flag.evidence
              ? `<p class="mt-2 rounded bg-(--color-bg) px-2 py-1 font-mono text-xs text-(--color-text-muted)">${escapeHtml(flag.evidence)}</p>`
              : ""
          }
        </li>`
          )
          .join("")
      : `<li class="rounded-lg border border-(--color-border) bg-(--color-surface-raised) p-4 text-sm text-(--color-text-muted)">No suspicious patterns detected by this tool. That doesn't guarantee it's safe &mdash; stay cautious with unexpected links.</li>`;

    resultsEl.classList.remove("hidden");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    resultsEl.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "start" });
  }
</script>
