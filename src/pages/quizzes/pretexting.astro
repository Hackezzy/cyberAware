---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pretexting Quiz"
  description="Test what you've learned about spotting a manufactured backstory before it earns your trust, with an explanation for every answer."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      Pretexting Quiz
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      Answer each question to test what you've learned. Every answer comes
      with an explanation, whether you get it right or wrong.
    </p>

    <div id="quiz-root" class="mt-8">
      <div>
        <div class="flex items-center justify-between text-sm">
          <p id="quiz-progress" class="font-medium text-(--color-text-muted)">
            Question 1 of 5
          </p>
          <p id="quiz-score" class="text-(--color-text-muted)">Score: 0</p>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-(--color-surface-raised)">
          <div
            id="progress-bar"
            class="h-full rounded-full bg-(--color-accent) transition-[width]"
            style="width: 0%"
          >
          </div>
        </div>
      </div>

      <div id="question-card" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6">
        <h2 id="question-text" class="text-lg font-bold text-(--color-text) focus:outline-none">
          &nbsp;
        </h2>

        <fieldset id="options-fieldset" class="mt-4 space-y-2 border-0 p-0">
          <legend class="sr-only">Choose one answer</legend>
        </fieldset>

        <button
          type="button"
          id="submit-answer"
          disabled
          class="mt-5 rounded-lg bg-(--color-accent) px-6 py-3 font-semibold text-(--color-bg) transition-colors hover:bg-(--color-accent-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) disabled:cursor-not-allowed disabled:opacity-40"
        >
          Submit Answer
        </button>

        <div id="explanation-panel" hidden aria-live="polite" class="mt-5 rounded-lg border-2 border-(--color-safe) bg-(--color-safe)/10 p-4">
          <p id="explanation-result" class="font-semibold text-(--color-safe)">Correct!</p>
          <p id="explanation-text" class="mt-1 text-sm text-(--color-text-muted)">
            &nbsp;
          </p>
          <button
            type="button"
            id="next-question"
            class="mt-4 rounded-lg bg-(--color-accent) px-6 py-3 font-semibold text-(--color-bg) transition-colors hover:bg-(--color-accent-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
          >
            Next Question
          </button>
        </div>
      </div>

      <div id="results-panel" hidden class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 text-center">
        <h2 class="text-xl font-bold text-(--color-text) focus:outline-none">Quiz complete</h2>
        <p id="results-score" class="mt-2 text-3xl font-extrabold text-(--color-accent)">0 / 5</p>
        <p id="results-message" class="mt-2 text-(--color-text-muted)">
          &nbsp;
        </p>
        <button
          type="button"
          id="retry-quiz"
          class="mt-5 rounded-lg border border-(--color-border) px-6 py-3 font-semibold text-(--color-text) transition-colors hover:bg-(--color-surface-raised) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
        >
          Try Again
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { createQuiz } from "../../lib/quiz-engine.js";
  import questions from "../../data/quiz-questions/pretexting.json";

  const root = document.getElementById("quiz-root") as HTMLElement;
  createQuiz({ root, questions, itemId: "quiz-pretexting" });
</script>
