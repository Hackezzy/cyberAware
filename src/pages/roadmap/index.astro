---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DOMAINS, LEVELS, CURRICULUM_ITEMS } from "../../data/curriculum.js";

const TYPE_LABEL = { simulation: "Simulation", quiz: "Quiz", tool: "Tool" };
---

<BaseLayout
  title="Roadmap"
  description="A guided path through CyberAware, organized by security domain and difficulty level — so you know what to do next instead of clicking around at random."
>
  <section class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      Roadmap
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      A structured path through every simulation, tool, and quiz &mdash;
      grouped by security domain, and ordered by difficulty within each one.
      Complete a level to unlock the next.
    </p>

    <div class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-4">
      <div class="flex items-center justify-between text-sm">
        <span class="font-medium text-(--color-text)">Overall progress</span>
        <span id="overall-progress-text" class="text-(--color-text-muted)">0 / 0 complete</span>
      </div>
      <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-(--color-surface-raised)">
        <div id="overall-progress-bar" class="h-full rounded-full bg-(--color-accent) transition-[width]" style="width: 0%"></div>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-3 text-xs text-(--color-text-muted)">
      <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-(--color-safe)"></span> Completed</span>
      <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-(--color-accent)"></span> Ready to start</span>
      <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-(--color-text-muted)"></span> Locked (finish the level before it first)</span>
      <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full border border-dashed border-(--color-border)"></span> Not built yet</span>
    </div>

    <div class="mt-10 space-y-10">
      {
        DOMAINS.map((domain) => {
          const domainItems = CURRICULUM_ITEMS.filter((i) => i.domain === domain.id);
          if (domainItems.length === 0) return null;
          const levelsInDomain = LEVELS.filter((lvl) =>
            domainItems.some((i) => i.level === lvl.id)
          );
          return (
            <div data-domain-section={domain.id}>
              <h2 class="text-xl font-bold text-(--color-text)">{domain.name}</h2>
              <p class="mt-1 text-sm text-(--color-text-muted)">{domain.description}</p>

              <div class="mt-4 space-y-4">
                {levelsInDomain.map((level) => {
                  const items = domainItems.filter((i) => i.level === level.id);
                  return (
                    <div
                      data-level-group
                      data-domain={domain.id}
                      data-level={level.id}
                      class="rounded-lg border border-(--color-border) bg-(--color-surface) p-4"
                    >
                      <h3 class="text-sm font-semibold text-(--color-text)">
                        Level {level.id} &mdash; {level.name}
                        <span class="ml-2 font-normal text-(--color-text-muted)">{level.description}</span>
                      </h3>
                      <ul class="mt-3 space-y-2">
                        {items.map((item) => (
                          <li
                            data-item
                            data-item-id={item.id}
                            data-available={String(item.available)}
                            class="flex items-center justify-between gap-3 rounded-md border border-(--color-border) bg-(--color-bg) px-3 py-2"
                          >
                            <div class="flex items-center gap-2">
                              <span
                                data-status-dot
                                class="h-2.5 w-2.5 shrink-0 rounded-full border border-dashed border-(--color-border)"
                              />
                              <a
                                data-item-link
                                href={item.available ? item.href : undefined}
                                aria-disabled={!item.available}
                                class="text-sm text-(--color-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
                              >
                                {item.title}
                              </a>
                              <span class="rounded-full border border-(--color-border) px-2 py-0.5 text-xs text-(--color-text-muted)">
                                {TYPE_LABEL[item.type]}
                              </span>
                            </div>
                            <span data-status-label class="text-xs text-(--color-text-muted)">
                              {item.available ? "" : "Coming soon"}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { CURRICULUM_ITEMS } from "../../data/curriculum.js";
  import { isCompleted, getProgressSummary } from "../../lib/progress-store.js";

  const STATUS_DOT_CLASSES = {
    completed: "h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-safe)",
    ready: "h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-accent)",
    locked: "h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-text-muted)",
    unbuilt: "h-2.5 w-2.5 shrink-0 rounded-full border border-dashed border-(--color-border)",
  };

  function isLevelUnlocked(domainId, level) {
    if (level <= 1) return true;
    const priorAvailableItems = CURRICULUM_ITEMS.filter(
      (item) => item.domain === domainId && item.level < level && item.available
    );
    if (priorAvailableItems.length === 0) return true;
    return priorAvailableItems.every((item) => isCompleted(item.id));
  }

  function render() {
    const groups = document.querySelectorAll("[data-level-group]");
    groups.forEach((group) => {
      const domainId = group.getAttribute("data-domain");
      const level = Number(group.getAttribute("data-level"));
      const unlocked = isLevelUnlocked(domainId, level);

      group.querySelectorAll("[data-item]").forEach((li) => {
        const itemId = li.getAttribute("data-item-id");
        const available = li.getAttribute("data-available") === "true";
        const dot = li.querySelector("[data-status-dot]");
        const link = li.querySelector("[data-item-link]");
        const label = li.querySelector("[data-status-label]");
        const completed = available && isCompleted(itemId);

        let status = "unbuilt";
        if (available) {
          status = completed ? "completed" : unlocked ? "ready" : "locked";
        }

        dot.className = STATUS_DOT_CLASSES[status];

        if (status === "ready" || status === "completed") {
          link.classList.add("hover:underline");
          link.removeAttribute("aria-disabled");
          link.style.pointerEvents = "";
          link.style.opacity = "";
        } else {
          link.removeAttribute("href");
          link.setAttribute("aria-disabled", "true");
          link.style.pointerEvents = "none";
          link.style.opacity = "0.6";
        }

        label.textContent =
          status === "completed"
            ? "✓ Completed"
            : status === "locked"
              ? "Locked"
              : status === "unbuilt"
                ? "Coming soon"
                : "Ready";
      });
    });

    const summary = getProgressSummary(CURRICULUM_ITEMS.filter((i) => i.available));
    const progressText = document.getElementById("overall-progress-text");
    const progressBar = document.getElementById("overall-progress-bar");
    if (progressText) progressText.textContent = `${summary.completed} / ${summary.total} complete`;
    if (progressBar) progressBar.style.width = `${summary.percent}%`;
  }

  render();
</script>
