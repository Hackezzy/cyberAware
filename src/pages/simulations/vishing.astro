---
import BaseLayout from "../../layouts/BaseLayout.astro";

const steps = [
  { title: "The Call" },
  { title: "The Voice" },
  { title: "The Pretext" },
  { title: "The Ask" },
  { title: "The Catch" },
  { title: "The Aftermath" },
];
---

<BaseLayout
  title="Vishing Simulation"
  description="An animated, step-by-step walkthrough of a voice-phishing (vishing) phone call."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      Vishing Simulation
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      Step through a voice-phishing call &mdash; the phone-call version of
      the scam, and one of the fastest-growing tactics as attackers start
      using AI to clone voices. Nothing here is real; "First Meridian Bank"
      is a made-up bank built just for this walkthrough.
    </p>

    <div class="mt-8">
      <p id="step-indicator" class="text-sm font-medium text-(--color-text-muted)">
        Step 1 of 6
      </p>
      <ol id="step-pills" class="mt-3 flex flex-wrap gap-2 text-sm">
        {
          steps.map((step, i) => (
            <li>
              <button
                type="button"
                data-pill-index={i}
                aria-current={i === 0 ? "step" : undefined}
                class:list={[
                  "rounded-full border px-3 py-1 transition-colors hover:border-(--color-accent) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)",
                  i === 0
                    ? "border-(--color-accent) text-(--color-accent)"
                    : "border-(--color-border) text-(--color-text-muted)",
                ]}
              >
                {i + 1}. {step.title}
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- ===================== SCENE 1: THE CALL ===================== -->
    <div data-scene-index="0" class="mt-10 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">1. The Call</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        A phone rings. The screen shows a name that looks trustworthy.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-wide text-(--color-text-muted)">Incoming call</p>
        <p class="mt-2 text-lg font-bold text-(--color-text)">First Meridian Bank</p>
        <p class="mt-1 font-mono text-sm text-(--color-text-muted)">(800) 555-0134</p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; Caller ID can be spoofed &mdash; a phone showing a bank's real name and number proves nothing about who is actually calling.</li>
          <li>&bull; A call feels more urgent and personal than an email, which is exactly why attackers use it.</li>
        </ul>
      </div>
    </div>

    <!-- ===================== SCENE 2: THE VOICE ===================== -->
    <div data-scene-index="1" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">2. The Voice</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        A calm, professional-sounding voice opens with the same greeting a
        real bank call center would use.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-5">
        <p class="text-sm text-(--color-text-muted)">
          "Thank you for banking with First Meridian. This is fraud
          prevention calling about unusual activity on your account. Am I
          speaking with the account holder?"
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          Attackers increasingly use AI-generated or cloned voices to sound
          calm, professional, and even to imitate someone the victim already
          knows &mdash; a real bank script isn't hard to copy, and neither is
          a real person's voice anymore.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 3: THE PRETEXT ===================== -->
    <div data-scene-index="2" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">3. The Pretext</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        The caller explains a scary-sounding problem they're supposedly
        already helping to fix.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-5">
        <p class="text-sm text-(--color-text-muted)">
          "We've flagged a $2,340 transfer attempt from your account. We've
          already blocked it, but I need to verify your identity to secure
          your account before the attacker tries again."
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          Framing themselves as already protecting you builds trust fast
          &mdash; it's much harder to be suspicious of someone who appears
          to already be on your side.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 4: THE ASK ===================== -->
    <div data-scene-index="3" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">4. The Ask</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        A text message arrives mid-call, and the caller asks for the code
        in it.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-5">
        <p class="text-sm text-(--color-text-muted)">
          "You should just receive a 6-digit verification code by text &mdash;
          that confirms you're the real account holder. Can you read that
          back to me?"
        </p>
        <p class="mt-3 rounded bg-(--color-surface) px-3 py-2 font-mono text-xs text-(--color-text-muted)">
          SMS: Your First Meridian verification code is <span class="font-semibold text-(--color-danger)">738214</span>. Do not share this code with anyone.
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          That code is a real one-time password, sent because the attacker
          is simultaneously trying to log in or reset the password on the
          real account &mdash; the text even says not to share it, which the
          caller is asking to override.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 5: THE CATCH ===================== -->
    <div data-scene-index="4" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">5. The Catch</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        The code is read aloud. The attacker uses it immediately.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4 font-mono text-xs text-(--color-text-muted)">
        <p>[attacker, real time] entering code 738214 at real login page...</p>
        <p class="text-(--color-danger)">[status] identity verified &mdash; password reset granted</p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          The code only works for a minute or two, so the attacker uses it
          the instant it's read out &mdash; by the time the call ends, the
          real account may already be locked out from the other side.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 6: THE AFTERMATH ===================== -->
    <div data-scene-index="5" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">6. The Aftermath</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        Voice cloning is making this attack harder to spot by ear alone
        &mdash; here's how to actually stay safe on a call.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4">
        <p class="text-sm text-(--color-text-muted)">
          AI-generated voices and caller ID spoofing are cited as some of
          the fastest-growing threats to individuals and small businesses,
          precisely because they defeat "I'd recognize that voice" as a
          safety check.
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-safe)/40 bg-(--color-safe)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-safe)">Prevention checklist</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; A real bank will never ask you to read back a one-time code &mdash; that code exists specifically to prove a request came from you, not from them.</li>
          <li>&bull; Hang up and call back using the number on your card or statement, never a number the caller gives you.</li>
          <li>&bull; Caller ID showing a familiar name or number is not verification &mdash; it can be spoofed just as easily as an email display name.</li>
          <li>&bull; If a call creates pressure to act immediately, that pressure is itself a red flag, regardless of how calm the caller sounds.</li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex justify-between gap-3">
      <button
        type="button"
        id="prev-step"
        class="rounded-lg border border-(--color-border) px-6 py-3 font-semibold text-(--color-text) transition-colors hover:bg-(--color-surface-raised) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) disabled:cursor-not-allowed disabled:opacity-40"
      >
        Previous
      </button>
      <button
        type="button"
        id="next-step"
        class="rounded-lg bg-(--color-accent) px-6 py-3 font-semibold text-(--color-bg) transition-colors hover:bg-(--color-accent-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
      >
        Next
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import { markCompleted } from "../../lib/progress-store.js";

  const TOTAL_STEPS = 6;

  const sceneEls = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scene-index]")
  ).sort((a, b) => Number(a.dataset.sceneIndex) - Number(b.dataset.sceneIndex));
  const pillEls = Array.from(
    document.querySelectorAll<HTMLElement>("[data-pill-index]")
  ).sort((a, b) => Number(a.dataset.pillIndex) - Number(b.dataset.pillIndex));
  const stepIndicator = document.getElementById("step-indicator") as HTMLParagraphElement;
  const prevBtn = document.getElementById("prev-step") as HTMLButtonElement;
  const nextBtn = document.getElementById("next-step") as HTMLButtonElement;

  const ACTIVE_PILL = ["border-(--color-accent)", "text-(--color-accent)"];
  const INACTIVE_PILL = ["border-(--color-border)", "text-(--color-text-muted)"];

  let currentIndex = 0;

  sceneEls.forEach((scene, i) => {
    if (i !== 0) scene.hidden = true;
  });

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function updateChrome() {
    stepIndicator.textContent = `Step ${currentIndex + 1} of ${TOTAL_STEPS}`;

    pillEls.forEach((pill, i) => {
      const isActive = i === currentIndex;
      pill.classList.remove(...ACTIVE_PILL, ...INACTIVE_PILL);
      pill.classList.add(...(isActive ? ACTIVE_PILL : INACTIVE_PILL));
      if (isActive) {
        pill.setAttribute("aria-current", "step");
      } else {
        pill.removeAttribute("aria-current");
      }
    });

    prevBtn.disabled = currentIndex === 0;
    nextBtn.textContent = currentIndex === TOTAL_STEPS - 1 ? "Restart" : "Next";

    if (currentIndex === TOTAL_STEPS - 1) {
      markCompleted("sim-vishing");
    }
  }

  function goToStep(newIndex: number) {
    if (newIndex === currentIndex) return;

    const oldEl = sceneEls[currentIndex];
    const newEl = sceneEls[newIndex];
    currentIndex = newIndex;
    updateChrome();

    const focusNewHeading = () => {
      const heading = newEl.querySelector<HTMLElement>("h2");
      heading?.focus();
    };

    if (prefersReducedMotion()) {
      oldEl.hidden = true;
      newEl.hidden = false;
      focusNewHeading();
      return;
    }

    oldEl.classList.add("opacity-0");
    window.setTimeout(() => {
      oldEl.hidden = true;
      oldEl.classList.remove("opacity-0");

      newEl.classList.add("opacity-0");
      newEl.hidden = false;
      void newEl.offsetWidth;
      newEl.classList.remove("opacity-0");

      focusNewHeading();
    }, 150);
  }

  prevBtn.addEventListener("click", () => {
    if (currentIndex > 0) goToStep(currentIndex - 1);
  });

  nextBtn.addEventListener("click", () => {
    if (currentIndex === TOTAL_STEPS - 1) {
      goToStep(0);
    } else {
      goToStep(currentIndex + 1);
    }
  });

  pillEls.forEach((pill, i) => {
    pill.addEventListener("click", () => goToStep(i));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    const active = document.activeElement;
    const withinWalkthrough =
      active === prevBtn ||
      active === nextBtn ||
      pillEls.includes(active as HTMLElement) ||
      sceneEls.some((scene) => scene.contains(active));
    if (!withinWalkthrough) return;

    event.preventDefault();
    if (event.key === "ArrowLeft" && currentIndex > 0) goToStep(currentIndex - 1);
    if (event.key === "ArrowRight" && currentIndex < TOTAL_STEPS - 1) goToStep(currentIndex + 1);
  });

  updateChrome();
</script>
