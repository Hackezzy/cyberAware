---
import BaseLayout from "../../layouts/BaseLayout.astro";

const steps = [
  { title: "The Drop" },
  { title: "The Find" },
  { title: "The Plug-In" },
  { title: "The Payload" },
  { title: "The Foothold" },
  { title: "The Aftermath" },
];
---

<BaseLayout
  title="Baiting Simulation"
  description="An animated, step-by-step walkthrough of a baiting attack using a planted USB drive."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      Baiting Simulation
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      Step through how a single "found" USB drive can compromise a company
      network. This walkthrough continues the story of Meridian Bookkeeping
      from the Ransomware simulation.
    </p>

    <div class="mt-8">
      <p id="step-indicator" class="text-sm font-medium text-(--color-text-muted)">
        Step 1 of 6
      </p>
      <ol id="step-pills" class="mt-3 flex flex-wrap gap-2 text-sm">
        {
          steps.map((step, i) => (
            <li>
              <button
                type="button"
                data-pill-index={i}
                aria-current={i === 0 ? "step" : undefined}
                class:list={[
                  "rounded-full border px-3 py-1 transition-colors hover:border-(--color-accent) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)",
                  i === 0
                    ? "border-(--color-accent) text-(--color-accent)"
                    : "border-(--color-border) text-(--color-text-muted)",
                ]}
              >
                {i + 1}. {step.title}
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- ===================== SCENE 1: THE DROP ===================== -->
    <div data-scene-index="0" class="mt-10 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">1. The Drop</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        An attacker leaves a USB drive in Meridian Bookkeeping's parking
        lot, with a label designed to be irresistible.
      </p>

      <div class="mt-4 flex justify-center rounded-lg border border-(--color-border) bg-(--color-bg) p-6">
        <div class="rounded-md border-2 border-(--color-danger) bg-(--color-surface) px-4 py-3 text-center">
          <p class="text-2xl">💾</p>
          <p class="mt-1 font-mono text-xs text-(--color-danger)">2026_Salary_Review_CONFIDENTIAL</p>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; The label is chosen specifically to be too interesting to ignore &mdash; salary information, layoffs, or bonuses are common bait themes.</li>
          <li>&bull; A parking lot or lobby, somewhere employees naturally pass through, means the attacker doesn't need to enter the building at all.</li>
        </ul>
      </div>
    </div>

    <!-- ===================== SCENE 2: THE FIND ===================== -->
    <div data-scene-index="1" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">2. The Find</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        An employee walking in spots it and picks it up.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4">
        <p class="text-sm text-(--color-text-muted)">
          "Huh, someone must have dropped this. 'Confidential Salary
          Review'? I should probably see whose it is..."
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          Curiosity and a genuine desire to help ("I should find the owner")
          are both completely normal reactions &mdash; the bait is designed
          around good instincts, not carelessness.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 3: THE PLUG-IN ===================== -->
    <div data-scene-index="2" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">3. The Plug-In</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        Back at their desk, the employee plugs it into a work computer to
        check it.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4 font-mono text-xs text-(--color-text-muted)">
        <p>[system] USB device connected: "SanDisk 32GB"</p>
        <p>[system] opening drive contents...</p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          A work computer, connected to the company network, is exactly
          where this drive was meant to end up &mdash; a home computer with
          no network access would be far less valuable to the attacker.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 4: THE PAYLOAD ===================== -->
    <div data-scene-index="3" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">4. The Payload</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        The drive shows one file &mdash; opening it runs a hidden program
        instead of a spreadsheet.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4">
        <div class="flex items-center gap-3 rounded border border-(--color-border) bg-(--color-surface) px-3 py-2 font-mono text-sm">
          <span class="text-(--color-danger)">📊</span>
          <span class="flex-1 text-(--color-text)">Salary_Review_2026.xlsx</span><span class="text-(--color-danger)">.scr</span>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          <code class="text-(--color-danger)">.scr</code> is a Windows screensaver file
          type that can run just like a program &mdash; disguised behind a
          spreadsheet icon and a name that ends in ".xlsx" before the real,
          hidden extension.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 5: THE FOOTHOLD ===================== -->
    <div data-scene-index="4" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">5. The Foothold</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        Nothing visible opens. In the background, the attacker gains quiet
        remote access.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4 font-mono text-xs text-(--color-text-muted)">
        <p>[background] installing persistence...</p>
        <p class="text-(--color-danger)">[background] remote access established for attacker</p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          This is the same "quiet foothold" moment as the Ransomware
          simulation &mdash; baiting is often just the delivery method,
          not a different end goal. From here, the attacker could deploy
          ransomware, steal data, or simply watch.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 6: THE AFTERMATH ===================== -->
    <div data-scene-index="5" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">6. The Aftermath</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        A single curious click, and the network is compromised &mdash;
        here's how to actually avoid this one.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4">
        <p class="text-sm text-(--color-text-muted)">
          Security researchers have repeatedly demonstrated this exact
          scenario in real workplace tests &mdash; a meaningful share of
          planted drives get plugged into a work computer within minutes of
          being found.
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-safe)/40 bg-(--color-safe)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-safe)">Prevention checklist</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; Never plug an unknown USB drive into any device, work or personal &mdash; hand it to IT or security instead.</li>
          <li>&bull; A tempting label is itself a warning sign, not a reason to look &mdash; genuine confidential files aren't distributed by leaving them on the ground.</li>
          <li>&bull; Businesses can disable AutoRun and restrict USB ports by policy, so even a plugged-in drive can't silently execute anything.</li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex justify-between gap-3">
      <button
        type="button"
        id="prev-step"
        class="rounded-lg border border-(--color-border) px-6 py-3 font-semibold text-(--color-text) transition-colors hover:bg-(--color-surface-raised) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) disabled:cursor-not-allowed disabled:opacity-40"
      >
        Previous
      </button>
      <button
        type="button"
        id="next-step"
        class="rounded-lg bg-(--color-accent) px-6 py-3 font-semibold text-(--color-bg) transition-colors hover:bg-(--color-accent-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
      >
        Next
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import { markCompleted } from "../../lib/progress-store.js";

  const TOTAL_STEPS = 6;

  const sceneEls = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scene-index]")
  ).sort((a, b) => Number(a.dataset.sceneIndex) - Number(b.dataset.sceneIndex));
  const pillEls = Array.from(
    document.querySelectorAll<HTMLElement>("[data-pill-index]")
  ).sort((a, b) => Number(a.dataset.pillIndex) - Number(b.dataset.pillIndex));
  const stepIndicator = document.getElementById("step-indicator") as HTMLParagraphElement;
  const prevBtn = document.getElementById("prev-step") as HTMLButtonElement;
  const nextBtn = document.getElementById("next-step") as HTMLButtonElement;

  const ACTIVE_PILL = ["border-(--color-accent)", "text-(--color-accent)"];
  const INACTIVE_PILL = ["border-(--color-border)", "text-(--color-text-muted)"];

  let currentIndex = 0;

  sceneEls.forEach((scene, i) => {
    if (i !== 0) scene.hidden = true;
  });

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function updateChrome() {
    stepIndicator.textContent = `Step ${currentIndex + 1} of ${TOTAL_STEPS}`;

    pillEls.forEach((pill, i) => {
      const isActive = i === currentIndex;
      pill.classList.remove(...ACTIVE_PILL, ...INACTIVE_PILL);
      pill.classList.add(...(isActive ? ACTIVE_PILL : INACTIVE_PILL));
      if (isActive) {
        pill.setAttribute("aria-current", "step");
      } else {
        pill.removeAttribute("aria-current");
      }
    });

    prevBtn.disabled = currentIndex === 0;
    nextBtn.textContent = currentIndex === TOTAL_STEPS - 1 ? "Restart" : "Next";

    if (currentIndex === TOTAL_STEPS - 1) {
      markCompleted("sim-baiting");
    }
  }

  function goToStep(newIndex: number) {
    if (newIndex === currentIndex) return;

    const oldEl = sceneEls[currentIndex];
    const newEl = sceneEls[newIndex];
    currentIndex = newIndex;
    updateChrome();

    const focusNewHeading = () => {
      const heading = newEl.querySelector<HTMLElement>("h2");
      heading?.focus();
    };

    if (prefersReducedMotion()) {
      oldEl.hidden = true;
      newEl.hidden = false;
      focusNewHeading();
      return;
    }

    oldEl.classList.add("opacity-0");
    window.setTimeout(() => {
      oldEl.hidden = true;
      oldEl.classList.remove("opacity-0");

      newEl.classList.add("opacity-0");
      newEl.hidden = false;
      void newEl.offsetWidth;
      newEl.classList.remove("opacity-0");

      focusNewHeading();
    }, 150);
  }

  prevBtn.addEventListener("click", () => {
    if (currentIndex > 0) goToStep(currentIndex - 1);
  });

  nextBtn.addEventListener("click", () => {
    if (currentIndex === TOTAL_STEPS - 1) {
      goToStep(0);
    } else {
      goToStep(currentIndex + 1);
    }
  });

  pillEls.forEach((pill, i) => {
    pill.addEventListener("click", () => goToStep(i));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    const active = document.activeElement;
    const withinWalkthrough =
      active === prevBtn ||
      active === nextBtn ||
      pillEls.includes(active as HTMLElement) ||
      sceneEls.some((scene) => scene.contains(active));
    if (!withinWalkthrough) return;

    event.preventDefault();
    if (event.key === "ArrowLeft" && currentIndex > 0) goToStep(currentIndex - 1);
    if (event.key === "ArrowRight" && currentIndex < TOTAL_STEPS - 1) goToStep(currentIndex + 1);
  });

  updateChrome();
</script>
