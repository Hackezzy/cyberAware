---
import BaseLayout from "../../layouts/BaseLayout.astro";

const steps = [
  { title: "The Delivery" },
  { title: "The Foothold" },
  { title: "The Spread" },
  { title: "The Lock" },
  { title: "The Choice" },
  { title: "The Aftermath" },
];
---

<BaseLayout
  title="Ransomware Simulation"
  description="An animated, step-by-step walkthrough of how ransomware actually spreads and locks a system."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-(--color-text)">
      Ransomware Simulation
    </h1>
    <p class="mt-2 max-w-2xl text-(--color-text-muted)">
      Step through how ransomware actually spreads through a small business,
      from a single opened attachment to every file being locked. Nothing
      here is real &mdash; "Meridian Bookkeeping" is a made-up small business
      built just for this walkthrough.
    </p>

    <div class="mt-8">
      <p id="step-indicator" class="text-sm font-medium text-(--color-text-muted)">
        Step 1 of 6
      </p>
      <ol id="step-pills" class="mt-3 flex flex-wrap gap-2 text-sm">
        {
          steps.map((step, i) => (
            <li>
              <button
                type="button"
                data-pill-index={i}
                aria-current={i === 0 ? "step" : undefined}
                class:list={[
                  "rounded-full border px-3 py-1 transition-colors hover:border-(--color-accent) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)",
                  i === 0
                    ? "border-(--color-accent) text-(--color-accent)"
                    : "border-(--color-border) text-(--color-text-muted)",
                ]}
              >
                {i + 1}. {step.title}
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- ===================== SCENE 1: THE DELIVERY ===================== -->
    <div data-scene-index="0" class="mt-10 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">1. The Delivery</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        A bookkeeper at Meridian Bookkeeping opens an email attachment that
        looks like a routine invoice.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-(--color-text-muted)">
          Downloads
        </p>
        <div class="mt-3 flex items-center gap-3 rounded border border-(--color-border) bg-(--color-surface) px-3 py-2 font-mono text-sm">
          <span class="text-(--color-danger)">📄</span>
          <span class="text-(--color-text)">Invoice_40218</span><span class="text-(--color-danger)">.pdf.exe</span>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; The real file extension is <code class="text-(--color-danger)">.exe</code> (a program), not <code class="text-(--color-danger)">.pdf</code> &mdash; the ".pdf" is just part of the filename, designed to look harmless at a glance.</li>
          <li>&bull; Windows hides known file extensions by default, so many people would only see "Invoice_40218.pdf" and never notice the <code class="text-(--color-danger)">.exe</code> at all.</li>
        </ul>
      </div>
    </div>

    <!-- ===================== SCENE 2: THE FOOTHOLD ===================== -->
    <div data-scene-index="1" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">2. The Foothold</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        Double-clicking the file runs it. Nothing visibly happens &mdash;
        that's by design.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4 font-mono text-xs text-(--color-text-muted)">
        <p>[background] disabling File History...</p>
        <p>[background] deleting Volume Shadow Copies...</p>
        <p>[background] scanning for network shares...</p>
        <p>[background] establishing outbound connection...</p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; The malware quietly disables Windows' built-in backup and file-recovery features first, before doing anything else &mdash; so there's nothing easy to restore from later.</li>
          <li>&bull; It scans for other computers and shared drives on the same network it can reach, to spread beyond just this one machine.</li>
        </ul>
      </div>
    </div>

    <!-- ===================== SCENE 3: THE SPREAD ===================== -->
    <div data-scene-index="2" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">3. The Spread</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        Over the next few hours, files are quietly encrypted &mdash; on this
        computer and every shared drive it could reach.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4">
        <ul class="space-y-1 font-mono text-xs text-(--color-text-muted)">
          <li>C:\Users\bookkeeper\Documents\Q3_Payroll.xlsx <span class="text-(--color-danger)">→ Q3_Payroll.xlsx.locked</span></li>
          <li>\\MERIDIAN-NAS\Shared\Client_Invoices\ <span class="text-(--color-danger)">→ encrypting (212 files)</span></li>
          <li>\\MERIDIAN-NAS\Shared\Tax_Records\ <span class="text-(--color-danger)">→ encrypting (89 files)</span></li>
        </ul>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; Encryption is deliberately slow and quiet so it isn't noticed until it's mostly finished &mdash; by the time anyone sees a problem, the damage is already done.</li>
          <li>&bull; A shared network drive means one infected laptop can lock every other computer's files too, not just its own.</li>
        </ul>
      </div>
    </div>

    <!-- ===================== SCENE 4: THE LOCK ===================== -->
    <div data-scene-index="3" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">4. The Lock</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        A note appears. Every file on the network is now unreadable.
      </p>

      <div class="mt-4 rounded-lg border-2 border-(--color-danger) bg-(--color-bg) p-5 text-center">
        <p class="text-lg font-bold text-(--color-danger)">YOUR FILES HAVE BEEN ENCRYPTED</p>
        <p class="mt-3 text-sm text-(--color-text-muted)">
          To recover your files, send 1.4 BTC to the address below within <span
            class="font-semibold text-(--color-danger)">72 hours</span>. The
          price doubles after the deadline. Do not contact law enforcement.
        </p>
        <p class="mt-3 rounded bg-(--color-surface) px-3 py-2 font-mono text-xs text-(--color-text-muted)">
          bc1q_x7f...9k2m (payment address)
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; The countdown and "do not contact law enforcement" warning are both pressure tactics, the same urgency trick used in phishing, just with much higher stakes.</li>
          <li>&bull; Cryptocurrency payment is untraceable and irreversible &mdash; there's no bank to call and dispute the charge afterward.</li>
        </ul>
      </div>
    </div>

    <!-- ===================== SCENE 5: THE CHOICE ===================== -->
    <div data-scene-index="4" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">5. The Choice</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        Paying feels like the fastest fix. It usually isn't.
      </p>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg border border-(--color-danger)/40 bg-(--color-danger)/10 p-4">
          <h3 class="text-sm font-semibold text-(--color-danger)">If you pay</h3>
          <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
            <li>&bull; No guarantee the attacker actually sends a working decryption key.</li>
            <li>&bull; Confirms this business pays, inviting repeat attacks.</li>
            <li>&bull; Funds further attacks against other victims.</li>
          </ul>
        </div>
        <div class="rounded-lg border border-(--color-safe)/40 bg-(--color-safe)/10 p-4">
          <h3 class="text-sm font-semibold text-(--color-safe)">What to do instead</h3>
          <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
            <li>&bull; Disconnect the machine from the network immediately, to stop the spread.</li>
            <li>&bull; Restore from an offline backup that was never connected when the attack happened.</li>
            <li>&bull; Report the incident &mdash; law enforcement and cybersecurity agencies track ransom payment addresses and can sometimes help.</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-warning)/40 bg-(--color-warning)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-warning)">What's happening</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          This decision only has a good outcome if it was prepared for
          <em>before</em> the attack &mdash; specifically, by keeping backups
          that ransomware on the network can't also reach and encrypt.
        </p>
      </div>
    </div>

    <!-- ===================== SCENE 6: THE AFTERMATH ===================== -->
    <div data-scene-index="5" class="mt-6 rounded-lg border border-(--color-border) bg-(--color-surface) p-6 transition-opacity duration-150">
      <h2 tabindex="-1" class="text-xl font-bold text-(--color-text) focus:outline-none">6. The Aftermath</h2>
      <p class="mt-1 text-sm text-(--color-text-muted)">
        Ransomware hits small businesses hardest &mdash; here's how to
        actually prevent this scene from happening.
      </p>

      <div class="mt-4 rounded-lg border border-(--color-border) bg-(--color-bg) p-4">
        <p class="text-sm text-(--color-text-muted)">
          Ransomware is involved in the large majority of breaches at small
          and medium businesses, far more than at large organizations &mdash;
          attackers assume smaller businesses have weaker backups and
          smaller security budgets.
        </p>
      </div>

      <div class="mt-4 rounded-lg border border-(--color-safe)/40 bg-(--color-safe)/10 p-4">
        <h3 class="text-sm font-semibold text-(--color-safe)">Prevention checklist</h3>
        <ul class="mt-2 space-y-1 text-sm text-(--color-text-muted)">
          <li>&bull; Keep at least one backup that's offline or otherwise disconnected from the network &mdash; a backup ransomware can also encrypt isn't a real backup.</li>
          <li>&bull; Never enable macros or run an attachment you weren't expecting, even from a sender you recognize.</li>
          <li>&bull; Show file extensions in your file browser instead of hiding them, so a "PDF" that's secretly a program is easier to spot.</li>
          <li>&bull; Keep software patched &mdash; many ransomware infections spread through known, already-fixed vulnerabilities.</li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex justify-between gap-3">
      <button
        type="button"
        id="prev-step"
        class="rounded-lg border border-(--color-border) px-6 py-3 font-semibold text-(--color-text) transition-colors hover:bg-(--color-surface-raised) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) disabled:cursor-not-allowed disabled:opacity-40"
      >
        Previous
      </button>
      <button
        type="button"
        id="next-step"
        class="rounded-lg bg-(--color-accent) px-6 py-3 font-semibold text-(--color-bg) transition-colors hover:bg-(--color-accent-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
      >
        Next
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import { markCompleted } from "../../lib/progress-store.js";

  const TOTAL_STEPS = 6;

  const sceneEls = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scene-index]")
  ).sort((a, b) => Number(a.dataset.sceneIndex) - Number(b.dataset.sceneIndex));
  const pillEls = Array.from(
    document.querySelectorAll<HTMLElement>("[data-pill-index]")
  ).sort((a, b) => Number(a.dataset.pillIndex) - Number(b.dataset.pillIndex));
  const stepIndicator = document.getElementById("step-indicator") as HTMLParagraphElement;
  const prevBtn = document.getElementById("prev-step") as HTMLButtonElement;
  const nextBtn = document.getElementById("next-step") as HTMLButtonElement;

  const ACTIVE_PILL = ["border-(--color-accent)", "text-(--color-accent)"];
  const INACTIVE_PILL = ["border-(--color-border)", "text-(--color-text-muted)"];

  let currentIndex = 0;

  sceneEls.forEach((scene, i) => {
    if (i !== 0) scene.hidden = true;
  });

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function updateChrome() {
    stepIndicator.textContent = `Step ${currentIndex + 1} of ${TOTAL_STEPS}`;

    pillEls.forEach((pill, i) => {
      const isActive = i === currentIndex;
      pill.classList.remove(...ACTIVE_PILL, ...INACTIVE_PILL);
      pill.classList.add(...(isActive ? ACTIVE_PILL : INACTIVE_PILL));
      if (isActive) {
        pill.setAttribute("aria-current", "step");
      } else {
        pill.removeAttribute("aria-current");
      }
    });

    prevBtn.disabled = currentIndex === 0;
    nextBtn.textContent = currentIndex === TOTAL_STEPS - 1 ? "Restart" : "Next";

    if (currentIndex === TOTAL_STEPS - 1) {
      markCompleted("sim-ransomware");
    }
  }

  function goToStep(newIndex: number) {
    if (newIndex === currentIndex) return;

    const oldEl = sceneEls[currentIndex];
    const newEl = sceneEls[newIndex];
    currentIndex = newIndex;
    updateChrome();

    const focusNewHeading = () => {
      const heading = newEl.querySelector<HTMLElement>("h2");
      heading?.focus();
    };

    if (prefersReducedMotion()) {
      oldEl.hidden = true;
      newEl.hidden = false;
      focusNewHeading();
      return;
    }

    oldEl.classList.add("opacity-0");
    window.setTimeout(() => {
      oldEl.hidden = true;
      oldEl.classList.remove("opacity-0");

      newEl.classList.add("opacity-0");
      newEl.hidden = false;
      void newEl.offsetWidth;
      newEl.classList.remove("opacity-0");

      focusNewHeading();
    }, 150);
  }

  prevBtn.addEventListener("click", () => {
    if (currentIndex > 0) goToStep(currentIndex - 1);
  });

  nextBtn.addEventListener("click", () => {
    if (currentIndex === TOTAL_STEPS - 1) {
      goToStep(0);
    } else {
      goToStep(currentIndex + 1);
    }
  });

  pillEls.forEach((pill, i) => {
    pill.addEventListener("click", () => goToStep(i));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    const active = document.activeElement;
    const withinWalkthrough =
      active === prevBtn ||
      active === nextBtn ||
      pillEls.includes(active as HTMLElement) ||
      sceneEls.some((scene) => scene.contains(active));
    if (!withinWalkthrough) return;

    event.preventDefault();
    if (event.key === "ArrowLeft" && currentIndex > 0) goToStep(currentIndex - 1);
    if (event.key === "ArrowRight" && currentIndex < TOTAL_STEPS - 1) goToStep(currentIndex + 1);
  });

  updateChrome();
</script>
