# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real ".env" file — it's already excluded in .gitignore.

GOOGLE_SAFE_BROWSING_API_KEY=your-real-key-goes-here

# Signs login session cookies. Generate a real random one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
# Keep it secret and stable — changing it logs every user out, since it
# invalidates every existing session cookie's signature.
SECRET_KEY=your-random-secret-key-goes-here

# Comma-separated list of origins allowed to make credentialed (cookie-
# carrying) requests to this backend. Must be the exact origin(s) the
# frontend is actually served from.
ALLOWED_ORIGINS=http://localhost:8080,https://cyberaware2.netlify.app

# MySQL connection. Needs a real MySQL server already installed and
# running -- see backend/README.md. The database itself (and its tables)
# get created automatically on first run if they don't exist yet.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-root-password-here
MYSQL_DATABASE=cyberaware
